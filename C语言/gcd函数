#include <stdio.h>

int gcd(int a, int b) {
	while (b != 0) {
		int r = a % b;
		a = b;
		b = r;
	}
	return a;
}

int main() {
	int a, b;
	scanf("%d%d", &a, &b);
	int g = gcd(a, b);
	int lcm = a / g * b;
	printf("%d", lcm);
}
