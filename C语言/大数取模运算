#include <stdio.h>

int mod1(int a) {
	return a % 10007;
}

int mod2(int m, int n) {
	return mod1(mod1(m) * mod1(n));
}

int mod3(int i, int j, int k) {
	return mod1(mod1(mod1(i) * mod1(j) ) * mod1(k));
}

int main() {
	int t, n;
	scanf("%d", &t);
	while (t--) {
		scanf("%d", &n);
		printf("%d\n", mod3(mod2(n, n + 1), mod2(n, n + 1), mod2(n, n + 1)));
	}


	return 0;
}
