#include <stdio.h>

int mod1(int a) {
	return a % 10007;
}

int mod2(int i, int j, int k) {
	return mod1(mod1(mod1(i) * mod1(j) ) * mod1(k));
}

int main() {
	int t, n, sum = 0;
	scanf("%d", &t);
	while (t--) {
		scanf("%d", &n);
		for (int i = 1; i <= n; i++) {
			for (int j = 1; j <= n; j++) {
				for (int k = 1; k <= n; k++) {
					sum += mod2(i, j, k);
					sum = mod1(sum);
				}
			}
		}
		sum = mod1(sum *= 8);
		printf("%d\n", sum);
		sum = 0;
	}

