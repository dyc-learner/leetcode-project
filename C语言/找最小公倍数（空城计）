#include <stdio.h>

int main() {
	int a, b, lcm, gcd;
	scanf("%d%d", &a, &b);
	if (a == 0 || b == 0) {
		printf("0");
	} else {
		int min = a;
		if (b < min) {
			min = b;
		}
		for (int i = 1; i <= min; i++) {
			if (a % i == 0 && b % i == 0) {
				gcd = i;
			}
		}
		lcm = a / gcd * b;
		printf("%d", lcm);
	}

}//gcd最大公因数，lcm最小公倍数；gcd*lcm==a*b;gcd用循环暴力求解
