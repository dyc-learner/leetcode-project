using namespace std;
class Solution {
public:
    vector<int> twoSum(vector<int>& nums, int target) {
      for(int i=0;i<nums.size();i++)
      {
        for(int j=0;j<i;j++)
        {
            if(nums[i]+nums[j]==target)
            {
                return {i,j};
            }
        }
      }  
      return {};
    }
};//1，判断相等用==；2，用nums.size()而不是sizeof()；3，{}是变量边界，外层无法读取内层；4，暴力双重循环vs哈希表（还不太了解）
